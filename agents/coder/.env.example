# Coder agent settings shared by bugline-repro and bugline-fixer. Copy to .env and fill in.
# Never commit .env. Defaults live in config.py; uncomment a line only to override it.
# Relative paths are taken from agents/coder/.

# --- Switch ---
# The server's API URL (the bridge), not the Gateway page. Same value as the front desk's.
# Check it: GET <url>/health returns {"status": "ok"}. Required.
SWITCH_API_URL=
# Registration key from the Gateway: API Keys > Create Registration Key. Same key as the front
# desk's. Used once per agent by `python agent.py --register`. Required for --register only.
SWITCH_REGISTRATION_KEY=
# Room id of bugline-eng (the front desk's `python agent.py --list-rooms` prints it). Required.
SWITCH_ENG_ROOM_ID=

# --- Which agent ---
# Set CODER_ROLE in the shell for each agent, not here, so one .env serves both:
#   reproducer -> bugline-repro, brief switch/agent-briefs/reproducer.md, C:\bugline-agents\bugline-repro
#   fixer      -> bugline-fixer, brief switch/agent-briefs/fixer.md,      C:\bugline-agents\bugline-fixer
# CODER_ROLE=reproducer
# Overrides for the role's defaults:
# CODER_AGENT_NAME=bugline-repro
# CODER_BRIEF=../../switch/agent-briefs/reproducer.md
# CODER_WORKDIR=C:\bugline-agents\bugline-repro

# --- Claude Code ---
# The claude binary, if it is not on PATH as `claude`.
# CODER_CLAUDE_BIN=C:\Users\<you>\.local\bin\claude.exe
# Seconds one Claude Code run may take before it is stopped (default 1800).
# CODER_TIMEOUT_S=1800

# --- Files ---
# Where state/<agent name>/credentials.json and connections.json live.
# CODER_STATE_DIR=state
