# Front desk agent settings. Copy to .env and fill in. Never commit .env.
# Defaults live in config.py; uncomment a line only to override it.
# Relative paths are taken from agents/frontdesk/.

# --- Gemini ---
# Google AI Studio key (https://aistudio.google.com/apikey). Required.
GEMINI_API_KEY=

# --- Files ---
# SQLite file with tickets, subscribers, drafts and the rate-guard log.
# FRONTDESK_DB=state/frontdesk.db
# One line per model call: time, model, purpose, status, prompt/output/total tokens.
# FRONTDESK_CALLS_LOG=calls.log
# Reference docs inserted into the prompts. In Docker, point these at the mounted repo files.
# FRONTDESK_INTAKE_RULES=../../switch/docs/intake-rules.md
# FRONTDESK_USER_FAQ=../../demo-app/README.md

# --- Tests ---
# Set to 1 (with GEMINI_API_KEY) to run the live smoke test: pytest -q -m live
# BUGLINE_LIVE=1

# --- Switch ---
# Bridge URL, agent id and API key are added with the Switch client.
