# Front desk agent settings. Copy to .env and fill in. Never commit .env.
# Defaults live in config.py; uncomment a line only to override it.
# Relative paths are taken from agents/frontdesk/.
# BUGLINE_CONFIG (another project's bugline.toml) is read before this file, so set it in the
# shell, not here. See docs/own-repo.md.

# --- Gemini ---
# Google AI Studio key (https://aistudio.google.com/apikey). Required.
GEMINI_API_KEY=

# --- Files ---
# SQLite file with tickets, subscribers, drafts and the rate-guard log.
# FRONTDESK_DB=state/frontdesk.db
# One line per model call: time, model, purpose, status, prompt/output/total tokens.
# FRONTDESK_CALLS_LOG=calls.log
# Reference docs inserted into the prompts. In Docker, point these at the mounted repo files.
# The user guide defaults to `user_guide` in bugline.toml.
# FRONTDESK_INTAKE_RULES=../../switch/docs/intake-rules.md
# FRONTDESK_USER_FAQ=../../demo-app/README.md

# --- Tests ---
# Set to 1 (with GEMINI_API_KEY) to run the live smoke test: pytest -q -m live
# BUGLINE_LIVE=1

# --- Switch ---
# scripts/bootstrap.py fills in the five values below; set them by hand only without it.
# The server's API URL (the bridge), not the Gateway page. Check it: GET <url>/health returns
# {"status": "ok"}. A Console-run server picks its ports at start and lists them in
# %APPDATA%\switchdash\local-switch-server\ports.json ("api"). Example: http://127.0.0.1:<port>.
# Inside Docker, use http://host.docker.internal:<port> (unverified against Console's server,
# which listens on 127.0.0.1 only). Required.
SWITCH_API_URL=
# Registration key, used once by `python agent.py --register` (or by bootstrap), which saves the
# agent id and API key to state/credentials.json. Bootstrap creates one if this is empty.
SWITCH_REGISTRATION_KEY=
# The chat app each room is on, as Switch names it in GET /gateway/collaborations (`bridge_type`):
# telegram, slack, mattermost, and so on.
# Only bootstrap reads these. They override [rooms] in bugline.toml, and bootstrap's
# --support-bridge / --eng-bridge flags win over both.
# BUGLINE_SUPPORT_BRIDGE=telegram
# BUGLINE_ENG_BRIDGE=slack
# Room ids for bugline-support and bugline-eng. Without bootstrap,
# `python agent.py --list-rooms` prints them once the agent is in both rooms. The front desk reads
# only the support room's id (required) and finds bugline-eng through the support room's
# "escalates to" link, then every support room bugline-eng links back to with "supports" (on
# any chat app). scripts/doctor.py reads both ids, and checks the link points at the eng id.
SWITCH_SUPPORT_ROOM_ID=
SWITCH_ENG_ROOM_ID=
# Agent id of bugline-repro (its state/bugline-repro/credentials.json "id"). Only that agent's
# `Verified BL-n: <PR link>` closes a ticket, besides the room owner's. Empty: only the owner can.
SWITCH_REPRODUCER_AGENT_ID=
# Optional: also address this agent by name when escalating. A role mention (@reproducer)
# reaches an agent only while its session holds the role; a name reaches it either way.
# FRONTDESK_REPRODUCER_NAME=bugline-repro
# Where credentials, connection ids and the database live. Docker mounts a volume here.
# FRONTDESK_STATE_DIR=state
