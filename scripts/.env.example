# Settings for scripts/setup_rooms.py. Copy to scripts/.env and fill in. scripts/.env is gitignored.
# Variables already set in the shell win over this file.

# The bridge (API) base URL, not the Gateway URL. Find it with `docker ps` and GET /health,
# as docs/switch-setup.md step 3 shows. Example: http://127.0.0.1:8000
SWITCH_API_URL=

# The front desk agent's id and API key, returned once when you registered it
# (agents/frontdesk/README.md). The script acts as the front desk.
FRONTDESK_AGENT_ID=
FRONTDESK_API_KEY=

# The two rooms, by name or by Switch room id. Leave empty for the defaults
# bugline-support and bugline-eng. Use the id if the Telegram room got another name.
SUPPORT_ROOM=
ENG_ROOM=

# The repo the agents work on. Leave empty for https://github.com/Ishaan2053/bugline.
REPO_URL=
